import type { APIRoute } from "astro";
import sharp from "sharp";

const MAX_FILE_SIZE_MB = Number(
  import.meta.env.MAX_FILE_SIZE_MB ?? 50
);

const MAX_FILE_SIZE =
  MAX_FILE_SIZE_MB * 1024 * 1024;

const allowedOutputs = new Set([
  "PNG",
  "JPG",
  "JPEG",
  "WEBP",
  "AVIF",
  "TIFF",
  "GIF"
]);

const mimeTypes: Record<string, string> = {
  PNG: "image/png",
  JPG: "image/jpeg",
  JPEG: "image/jpeg",
  WEBP: "image/webp",
  AVIF: "image/avif",
  TIFF: "image/tiff",
  GIF: "image/gif"
};

function sanitizeFileName(name: string) {
  return name
    .replace(/\.[^/.]+$/, "")
    .replace(/[^a-zA-Z0-9-_]/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-|-$/g, "")
    .slice(0, 100);
}

function normalizeOutput(value: string) {
  const output = value.trim().toUpperCase();

  if (output === "JPG") {
    return "JPEG";
  }

  return output;
}

export const POST: APIRoute = async ({ request }) => {
  try {
    const formData = await request.formData();

    const file = formData.get("file");

    if (!(file instanceof File)) {
      return Response.json(
        {
          success: false,
          error: "A file is required."
        },
        { status: 400 }
      );
    }

    if (file.size === 0) {
      return Response.json(
        {
          success: false,
          error: "The uploaded file is empty."
        },
        { status: 400 }
      );
    }

    if (file.size > MAX_FILE_SIZE) {
      return Response.json(
        {
          success: false,
          error: `Maximum file size is ${MAX_FILE_SIZE_MB} MB.`
        },
        { status: 413 }
      );
    }

    const requestedOutput = String(
      formData.get("output") ?? ""
    );

    const output =
      normalizeOutput(requestedOutput);

    if (!allowedOutputs.has(output)) {
      return Response.json(
        {
          success: false,
          error: "Unsupported output format."
        },
        { status: 400 }
      );
    }

    const qualityRaw = Number(
      formData.get("quality") ?? 85
    );

    const quality = Math.min(
      100,
      Math.max(1, qualityRaw)
    );

    const widthRaw = String(
      formData.get("width") ?? ""
    );

    const heightRaw = String(
      formData.get("height") ?? ""
    );

    const width = widthRaw
      ? Number(widthRaw)
      : undefined;

    const height = heightRaw
      ? Number(heightRaw)
      : undefined;

    const rotationRaw = Number(
      formData.get("rotation") ?? 0
    );

    const rotation =
      [0, 90, 180, 270].includes(rotationRaw)
        ? rotationRaw
        : 0;

    const background = String(
      formData.get("background") ?? "#ffffff"
    );

    const inputBuffer = Buffer.from(
      await file.arrayBuffer()
    );

    let image = sharp(inputBuffer, {
      failOn: "none"
    });

    if (width || height) {
      image = image.resize({
        width,
        height,
        fit: "inside",
        withoutEnlargement: false
      });
    }

    if (rotation) {
      image = image.rotate(rotation);
    }

    if (
      output === "JPEG" &&
      background
    ) {
      image = image
        .flatten({
          background
        })
        .jpeg({
          quality,
          mozjpeg: true
        });
    } else if (output === "PNG") {
      image = image.png({
        compressionLevel: 9
      });
    } else if (output === "WEBP") {
      image = image.webp({
        quality
      });
    } else if (output === "AVIF") {
      image = image.avif({
        quality
      });
    } else if (output === "TIFF") {
      image = image.tiff({
        quality
      });
    } else if (output === "GIF") {
      image = image.gif();
    }

    const outputBuffer =
      await image.toBuffer();

    const originalName =
      sanitizeFileName(file.name);

    const extension =
      output === "JPEG"
        ? "jpg"
        : output.toLowerCase();

    const fileName =
      `${originalName}.${extension}`;

    return new Response(
      new Uint8Array(outputBuffer),
      {
        status: 200,
        headers: {
          "Content-Type":
            mimeTypes[output] ??
            "application/octet-stream",
          "Content-Length":
            String(outputBuffer.length),
          "Content-Disposition":
            `attachment; filename="${fileName}"`,
          "Cache-Control":
            "no-store"
        }
      }
    );
  } catch (error) {
    console.error(error);

    return Response.json(
      {
        success: false,
        error: "Image conversion failed."
      },
      { status: 500 }
    );
  }
};