---
import { env } from "../lib/env";

const links = [
  { href: "/#convert", label: "Convert" },
  { href: "/#tools", label: "All tools" },
  { href: "/#formats", label: "Formats" }
];
---

<header
  class="sticky top-0 z-50 border-b border-zinc-200 bg-white/85 backdrop-blur-md dark:border-zinc-800 dark:bg-zinc-950/85"
>
  <div
    class="mx-auto flex max-w-shell items-center justify-between gap-4 px-5 py-3"
  >
    <a
      href="/"
      class="flex items-center gap-2.5 text-[15px] font-semibold tracking-tight text-zinc-900 dark:text-white"
    >
      <span
        class="flex h-7 w-7 items-center justify-center rounded-control bg-zinc-900 text-[11px] font-bold text-white dark:bg-white dark:text-zinc-900"
        aria-hidden="true"
      >
        D
      </span>
      {env.appName}
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="rounded-control px-3 py-2 text-sm text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-white"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <a
        href="/#convert"
        class="dc-btn dc-btn-primary dc-btn-sm hidden sm:inline-flex"
      >
        Convert a file
      </a>

      <button
        id="theme-toggle"
        type="button"
        aria-pressed={false}
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-control border border-zinc-200 text-zinc-600 transition hover:border-zinc-300 hover:bg-zinc-50 hover:text-zinc-900 dark:border-zinc-800 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-white"
      >
        <svg
          class="hidden h-4 w-4 dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            stroke-linecap="round"
            d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6l1.4 1.4m10 10 1.4 1.4m0-12.8-1.4 1.4m-10 10L5.6 18.4"
          ></path>
        </svg>
        <svg
          class="h-4 w-4 dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.6 6.6 0 0 0 9.8 9.8Z"
          ></path>
        </svg>
        <span class="sr-only">Toggle dark mode</span>
      </button>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById("theme-toggle");

  function reflect() {
    button?.setAttribute(
      "aria-pressed",
      String(document.documentElement.classList.contains("dark"))
    );
  }

  button?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");

    localStorage.setItem("theme", isDark ? "dark" : "light");
    reflect();
  });

  reflect();
</script>
