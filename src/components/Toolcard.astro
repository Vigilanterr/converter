---
import type { ToolConfig } from "../data/tools";

interface Props {
  tool: ToolConfig;
}

const { tool } = Astro.props;
---

<a
  href={`/${tool.slug}`}
  class="group rounded-2xl border border-zinc-200 bg-white p-5 transition duration-200 hover:-translate-y-1 hover:border-zinc-300 hover:shadow-xl hover:shadow-zinc-200/40 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-700 dark:hover:shadow-black/20"
>
  <div class="mb-5 flex items-center justify-between">
    <span class="rounded-lg bg-zinc-100 px-2.5 py-1 text-xs font-semibold text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
      {tool.inputFormats.join(" / ")}
    </span>

    <span class="text-zinc-400 transition group-hover:translate-x-1">
      →
    </span>
  </div>

  <h3 class="text-base font-semibold text-zinc-950 dark:text-white">
    {tool.title}
  </h3>

  <p class="mt-2 text-sm leading-6 text-zinc-500 dark:text-zinc-400">
    {tool.description}
  </p>

  <div class="mt-5 flex flex-wrap gap-2">
    {tool.outputFormats.map((format) => (
      <span class="text-xs text-zinc-400">
        → {format}
      </span>
    ))}
  </div>
</a>