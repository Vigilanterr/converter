---
import Layout from "@/layouts/Layouts.astro";
import Converter from "@/components/Converter.svelte"  
import { tools, toolMap } from "../data/tools";

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: {
      slug: tool.slug
    },
    props: {
      tool
    }
  }));
}

const { tool } = Astro.props;

if (!tool) {
  return Astro.redirect("/");
}

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: tool.title,
  description: tool.description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any"
};
---

<Layout
  title={`${tool.title} — FileForge`}
  description={tool.description}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />

  <section class="mx-auto max-w-7xl px-5 pb-20 pt-16">
    <div class="mx-auto max-w-3xl text-center">
      <div class="mb-5 inline-flex rounded-full bg-blue-50 px-3 py-1.5 text-xs font-semibold text-blue-600 dark:bg-blue-950/50 dark:text-blue-400">
        {tool.category}
      </div>

      <h1 class="text-4xl font-bold tracking-tight text-zinc-950 dark:text-white sm:text-5xl">
        {tool.title}
      </h1>

      <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-zinc-500 dark:text-zinc-400">
        {tool.description}
      </p>

      <p class="mt-4 text-sm text-zinc-400">
        {tool.inputFormats.join(", ")}
        →
        {tool.outputFormats.join(", ")}
      </p>
    </div>

    <div class="mt-12">
      <Converter
        client:load
        tool={tool}
      />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-24">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">
      Frequently Asked Questions
    </h2>

    <div class="mt-6 space-y-3">
      {tool.faq.map((item) => (
        <details class="group rounded-2xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
          <summary class="cursor-pointer list-none font-medium">
            {item.question}
          </summary>

          <p class="mt-3 text-sm leading-6 text-zinc-500 dark:text-zinc-400">
            {item.answer}
          </p>
        </details>
      ))}
    </div>
  </section>
</Layout>