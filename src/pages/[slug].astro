---
import Layout from "@/layouts/Layouts.astro";
import Converter from "@/components/Converter.svelte";
import { toolAcceptAttribute, tools, type ToolConfig } from "@/data/tools";
import { env } from "@/lib/env";

export const prerender = true;

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool }
  }));
}

interface Props {
  tool: ToolConfig;
}

const { tool } = Astro.props;

const pageTitle = `${tool.title} | ${env.appName}`;
const accept = toolAcceptAttribute(tool);
const inputList = tool.inputFormats.join(", ");
const outputList = tool.outputFormats.join(", ");
const whereItRuns = tool.browserSupported
  ? "In your browser"
  : "On the server";
const relatedTools = tools
  .filter(
    (candidate) =>
      candidate.slug !== tool.slug && candidate.category === tool.category
  )
  .slice(0, 4);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: tool.title,
      description: tool.description,
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Any",
      url: Astro.url.href,
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD"
      }
    },
    {
      "@type": "FAQPage",
      mainEntity: tool.faq.map((entry) => ({
        "@type": "Question",
        name: entry.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: entry.answer
        }
      }))
    }
  ]
};
---

<Layout title={pageTitle} description={tool.description}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />

  <div class="mx-auto max-w-shell px-5 py-10 sm:py-14">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-1.5 text-xs text-zinc-500">
        <li>
          <a
            href="/"
            class="rounded transition hover:text-zinc-900 dark:hover:text-white"
          >
            Home
          </a>
        </li>

        <li class="text-zinc-300 dark:text-zinc-600" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            class="h-3 w-3"
          >
            <path d="m9 6 6 6-6 6"></path>
          </svg>
        </li>

        <li>
          <a
            href="/#tools"
            class="rounded transition hover:text-zinc-900 dark:hover:text-white"
          >
            {tool.category.replace(/-/g, " ")}
          </a>
        </li>

        <li class="text-zinc-300 dark:text-zinc-600" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            class="h-3 w-3"
          >
            <path d="m9 6 6 6-6 6"></path>
          </svg>
        </li>

        <li aria-current="page" class="font-medium text-zinc-900 dark:text-white">
          {tool.title}
        </li>
      </ol>
    </nav>

    <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_17rem]">
      <div class="min-w-0">
        <header>
          <div class="flex flex-wrap items-center gap-2">
            <span class="dc-chip">{tool.category.replace(/-/g, " ")}</span>

            <span
              class="dc-chip {tool.browserSupported
                ? 'text-positive dark:text-emerald-300'
                : ''}"
            >
              Runs {whereItRuns.toLowerCase()}
            </span>
          </div>

          <h1
            class="mt-4 text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-white"
          >
            {tool.title}
          </h1>

          <p
            class="mt-4 max-w-2xl text-base leading-relaxed text-zinc-600 dark:text-zinc-400"
          >
            {tool.description}
          </p>
        </header>

        <div class="mt-8">
          <Converter
            client:load
            tool={tool}
            accept={accept}
            maxFileSizeMb={env.publicMaxFileSizeMb}
          />
        </div>

        <section class="mt-14" id="faq">
          <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">
            Frequently asked questions
          </h2>

          <div
            class="mt-5 divide-y divide-zinc-200 border-y border-zinc-200 dark:divide-zinc-800 dark:border-zinc-800"
          >
            {
              tool.faq.map((entry) => (
                <details class="group py-4">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium text-zinc-900 dark:text-zinc-100">
                    {entry.question}
                    <span
                      class="shrink-0 text-zinc-400 transition group-open:rotate-45"
                      aria-hidden="true"
                    >
                      +
                    </span>
                  </summary>

                  <p class="mt-3 max-w-2xl text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                    {entry.answer}
                  </p>
                </details>
              ))
            }
          </div>
        </section>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
        <div class="dc-card p-5">
          <h2 class="dc-eyebrow">Conversion</h2>

          <dl class="mt-4 space-y-3.5 text-sm">
            <div>
              <dt class="dc-kicker">Accepts</dt>
              <dd class="mt-1 font-medium text-zinc-900 dark:text-white">
                {inputList}
              </dd>
            </div>

            <div>
              <dt class="dc-kicker">Produces</dt>
              <dd class="mt-1 font-medium text-zinc-900 dark:text-white">
                {outputList}
              </dd>
            </div>

            <div>
              <dt class="dc-kicker">Options</dt>
              <dd class="mt-1 font-medium text-zinc-900 dark:text-white">
                {tool.options.length > 0 ? tool.options.join(", ") : "None"}
              </dd>
            </div>

            <div>
              <dt class="dc-kicker">Max file size</dt>
              <dd class="mt-1 font-medium text-zinc-900 dark:text-white">
                {env.maxFileSizeMb} MB
              </dd>
            </div>
          </dl>
        </div>

        {
          relatedTools.length > 0 && (
            <div class="dc-card p-5">
              <h2 class="dc-eyebrow">Related tools</h2>

              <ul class="mt-4 space-y-2.5">
                {relatedTools.map((related) => (
                  <li>
                    <a
                      href={`/${related.slug}`}
                      class="group flex items-center justify-between gap-2 text-sm text-zinc-600 transition hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white"
                    >
                      {related.title}
                      <span
                        class="text-zinc-300 transition group-hover:translate-x-0.5 dark:text-zinc-600"
                        aria-hidden="true"
                      >
                        &rarr;
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>
  </div>
</Layout>
