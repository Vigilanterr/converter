# PostgreSQL connection string used by Drizzle ORM and drizzle-kit.
DATABASE_URL=postgresql://postgres:password@localhost:5432/file_converter

# Maximum accepted upload size in megabytes.
MAX_FILE_SIZE_MB=50

# Lifetime of temporary input/output files in minutes.
TEMP_FILE_TTL_MINUTES=30

# Public application name rendered in the UI.
PUBLIC_APP_NAME=DarConverter

# Public upload limit, exposed to the browser for client-side validation.
PUBLIC_MAX_FILE_SIZE_MB=50

# Base URL of the PDF2Docx FastAPI service (Phase 2).
PDF2DOCX_URL=http://pdf2docx:8000
