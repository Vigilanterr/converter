---
import { env } from "../lib/env";
import { categories, tools } from "../data/tools";

const year = new Date().getFullYear();

const populated = categories.filter(
  (category) => tools.some((tool) => tool.category === category.id)
);
---

<footer class="mt-24 border-t border-zinc-200 dark:border-zinc-800">
  <div class="mx-auto max-w-shell px-5 py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <p class="flex items-center gap-2.5 text-sm font-semibold text-zinc-900 dark:text-white">
          <span
            class="flex h-6 w-6 items-center justify-center rounded-control bg-zinc-900 text-[10px] font-bold text-white dark:bg-white dark:text-zinc-900"
            aria-hidden="true"
          >
            D
          </span>
          {env.appName}
        </p>

        <p class="mt-3 max-w-sm text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
          Drop a file, convert it, check the preview, download the result.
          Simple image conversions run in your browser; vector tracing and PDF
          assembly run on the server.
        </p>
      </div>

      {
        populated.map((category) => (
          <div>
            <h2 class="dc-eyebrow">{category.title}</h2>

            <ul class="mt-3 space-y-2">
              {tools
                .filter((tool) => tool.category === category.id)
                .slice(0, 6)
                .map((tool) => (
                  <li>
                    <a
                      href={`/${tool.slug}`}
                      class="text-sm text-zinc-600 transition hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white"
                    >
                      {tool.title.replace(" Converter", "")}
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-zinc-200 pt-6 text-xs text-zinc-500 sm:flex-row sm:items-center sm:justify-between dark:border-zinc-800"
    >
      <p>© {year} {env.appName}</p>

      <p>
        Temporary uploads are deleted automatically after
        {" "}{env.tempFileTtlMinutes} minutes.
      </p>
    </div>
  </div>
</footer>
